{
  "name": "gedson-ai-mentor",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "website"
  ],
  "scripts": {
    "dev": "npm --workspace website run dev",
    "build": "npm --workspace website run build",
    "start": "npm --workspace website run start",
    "test": "npm --workspace website run test",
    "typecheck": "npm --workspace website run typecheck",
    "test:structure": "python3 tests/test_structure.py",
    "check": "npm run test:structure && npm run build && npm run typecheck"
  }
}
